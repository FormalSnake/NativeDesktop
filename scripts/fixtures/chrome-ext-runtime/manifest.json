{
  "manifest_version": 3,
  "name": "ND Runtime Extension",
  "version": "1.0",
  "description": "Fixture for the runtime install leg of scripts/headless-webview-cef-chrome.sh.",
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ND Runtime",
    "default_icon": { "16": "icon16.png" }
  },
  "icons": { "16": "icon16.png" },
  "permissions": ["storage"]
}
