#!/usr/bin/env bash
# The GPUI fork and its rebase gate (ARCHITECTURE.md 2.1).
#
# nd builds on the gpui-pre-* crates pinned in the workspace Cargo.toml. nd's own GPUI patches are
# a queue of `git format-patch` files (crates/nd-gpui/patches, applied in `series` order) on the
# zed commit that gpui-pre release snapshots (crates/nd-gpui/fork.toml). The queue reaches the
# build as vendored copies of the published crates it touches, with the queue applied, wired in
# through a generated [patch.crates-io] block.
#
#   apply            create the fork branch in the zed checkout: snapshot + queue (no-op if it exists)
#   export           write the fork branch's commits back into the queue
#   vendor           regenerate crates/nd-gpui/vendor and the [patch.crates-io] block from the queue
#   bump <version> <fast version>
#                    rebase the fork branch onto the snapshot of gpui-pre <version>, move the pins
#                    (gpui-fast with it: each release pins one gpui-pre), export, vendor, gate
#   gate             the rebase gate: queue applies, vendored crates match it, pins match the
#                    snapshot, tiers 1 and 2 pass, the raw GPUI window builds
#
# The zed checkout is $ND_ZED_DIR (default: on the cache drive on macOS, ~/.cache/nd/zed elsewhere).
# The gate and `vendor` never touch it: they apply the queue in a throwaway shared clone.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
fork_dir="$root/crates/nd-gpui"
conf="$fork_dir/fork.toml"
series="$fork_dir/patches/series"
vendor_dir="$fork_dir/vendor"
workspace="$root/Cargo.toml"
if [ "$(uname -s)" = Darwin ]; then
  zed="${ND_ZED_DIR:-/Volumes/Kyan Drive/dev-cache.noindex/zed}"
else
  zed="${ND_ZED_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/nd/zed}"
fi

die() { echo "gpui-fork: $*" >&2; exit 1; }
say() { echo "gpui-fork: $*"; }
get() { sed -n "s/^$1 = \"\(.*\)\"$/\1/p" "$conf"; }
set_conf() { K=$1 V=$2 perl -pi -e 's/^\Q$ENV{K}\E = ".*"$/$ENV{K} = "$ENV{V}"/' "$conf"; }
queue() { grep -v -e '^#' -e '^[[:space:]]*$' "$series" || true; }

# zed's crates/<dir> as the gpui-fast package that publishes its fork of it.
fast_package_for() {
  case "$1" in
    gpui) echo gpui-fast ;;
    gpui_*) echo "gpui-fast-$(echo "${1#gpui_}" | tr _ -)" ;;
    *) echo "gpui-fast-$(echo "$1" | tr _ -)" ;;
  esac
}

# zed's crates/<dir> as the gpui-pre package that publishes it.
package_for() {
  case "$1" in
    gpui) echo gpui-pre ;;
    gpui_*) echo "gpui-pre-$(echo "${1#gpui_}" | tr _ -)" ;;
    *) echo "gpui-pre-$(echo "$1" | tr _ -)" ;;
  esac
}

ensure_rev() {
  local rev=$1
  if [ ! -d "$zed/.git" ]; then
    mkdir -p "$zed"
    git -C "$zed" init -q
    git -C "$zed" remote add origin "$(get remote)"
  fi
  git -C "$zed" cat-file -e "$rev^{commit}" 2>/dev/null || git -C "$zed" fetch -q --depth 1 origin "$rev"
}

# Applies the queue onto the snapshot in a throwaway clone, staged but not committed, and prints
# the clone's parent directory. `git diff --cached <zed_rev>` there is the queue's whole change.
scratch_fork() {
  local rev tmp
  rev=$(get zed_rev)
  ensure_rev "$rev"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/nd-gpui-fork.XXXXXX")
  git clone -q --shared --no-checkout "$zed" "$tmp/zed"
  git -C "$tmp/zed" checkout -q --detach "$rev"
  while read -r patch; do
    git -C "$tmp/zed" apply --index --3way "$fork_dir/patches/$patch" >&2 || die "$patch does not apply on zed@${rev:0:7}"
  done < <(queue)
  echo "$tmp"
}

# Writes the vendored crates and the patch block for the current queue under $1 (a root holding
# crates/nd-gpui/vendor and Cargo.toml).
render_vendor() {
  local out=$1 version fast_version tmp dirs dir pkg src block
  version=$(get crate_version)
  fast_version=$(sed -n 's/^gpui_fast = { package = "gpui-fast", version = "=\([^"]*\)".*/\1/p' "$root/Cargo.toml")
  # Fetch while the workspace's own patch block still points at existing directories.
  [ -z "$(queue)" ] || (cd "$root" && cargo fetch -q)
  rm -rf "$out/crates/nd-gpui/vendor"
  block="# gpui-fork: begin, generated by scripts/gpui-fork vendor"
  if [ -n "$(queue)" ]; then
    tmp=$(scratch_fork)
    dirs=$(git -C "$tmp/zed" diff --cached --name-only "$(get zed_rev)" | sed -n 's#^crates/\([^/]*\)/.*#\1#p' | sort -u)
    [ -n "$dirs" ] || die "the queue changes no crate"
    block="$block
[patch.crates-io]"
    for dir in $dirs; do
      pkg=$(package_for "$dir")
      src=$(ls -d "${CARGO_HOME:-$HOME/.cargo}"/registry/src/*/"$pkg-$version" 2>/dev/null | head -1)
      [ -n "$src" ] || die "crates/$dir is not published as $pkg $version"
      mkdir -p "$out/crates/nd-gpui/vendor"
      cp -R "$src" "$out/crates/nd-gpui/vendor/$pkg"
      git -C "$tmp/zed" diff --cached "$(get zed_rev)" -- "crates/$dir" |
        patch -s -p3 --no-backup-if-mismatch -d "$out/crates/nd-gpui/vendor/$pkg" || die "the queue's change to crates/$dir does not apply to $pkg $version"
      block="$block
$pkg = { path = \"crates/nd-gpui/vendor/$pkg\" }"
      pkg=$(fast_package_for "$dir")
      src=$(ls -d "${CARGO_HOME:-$HOME/.cargo}"/registry/src/*/"$pkg-$fast_version" 2>/dev/null | head -1)
      [ -n "$src" ] || continue
      cp -R "$src" "$out/crates/nd-gpui/vendor/$pkg"
      git -C "$tmp/zed" diff --cached "$(get zed_rev)" -- "crates/$dir" |
        patch -s -p3 --no-backup-if-mismatch -d "$out/crates/nd-gpui/vendor/$pkg" || die "the queue's change to crates/$dir does not apply to $pkg $fast_version"
      block="$block
$pkg = { path = \"crates/nd-gpui/vendor/$pkg\" }"
    done
    rm -rf "$tmp"
  fi
  block="$block
# gpui-fork: end"
  perl -0pi -e 's/\n# gpui-fork: begin.*?# gpui-fork: end\n?//s' "$out/Cargo.toml"
  printf '\n%s\n' "$block" >>"$out/Cargo.toml"
}

cmd_apply() {
  local rev branch
  rev=$(get zed_rev)
  branch=$(get branch)
  ensure_rev "$rev"
  if git -C "$zed" rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
    say "$branch exists in $zed: $(git -C "$zed" rev-list --count "$rev..$branch") commit(s) on zed@${rev:0:7}"
    return
  fi
  [ -z "$(git -C "$zed" status --porcelain)" ] || die "$zed has uncommitted changes"
  git -C "$zed" switch -q -c "$branch" "$rev"
  while read -r patch; do
    git -C "$zed" am -q --3way "$fork_dir/patches/$patch" || die "$patch does not apply; resolve in $zed"
  done < <(queue)
  say "$branch in $zed: zed@${rev:0:7} + $(queue | wc -l | tr -d ' ') patch(es)"
}

cmd_export() {
  local rev branch
  rev=$(get zed_rev)
  branch=$(get branch)
  [ -z "$(git -C "$zed" status --porcelain)" ] || die "$zed has uncommitted changes"
  git -C "$zed" rev-parse -q --verify "refs/heads/$branch" >/dev/null || die "no $branch in $zed; run apply"
  while read -r patch; do rm -f "$fork_dir/patches/$patch"; done < <(queue)
  { sed -n '/^#/p' "$series"
    git -C "$zed" format-patch --zero-commit --no-signature -o "$fork_dir/patches" "$rev..$branch" | xargs -n1 basename
  } >"$series.new"
  mv "$series.new" "$series"
  say "exported $(queue | wc -l | tr -d ' ') patch(es)"
}

cmd_vendor() {
  render_vendor "$root"
  say "vendored: $(ls "$vendor_dir" 2>/dev/null | tr '\n' ' ')"
}

cmd_bump() {
  local version=${1:?usage: gpui-fork bump <gpui-pre version> <gpui-fast version>}
  local fast=${2:?usage: gpui-fork bump <gpui-pre version> <gpui-fast version>}
  local old_version old_rev short rev old_branch branch
  old_version=$(get crate_version)
  old_rev=$(get zed_rev)
  old_branch=$(get branch)
  short=$(cd "$root" && cargo info "gpui-pre@$version" 2>/dev/null | sed -n 's/.*snapshot of zed@\([0-9a-f]*\).*/\1/p')
  [ -n "$short" ] || die "cannot find the zed snapshot of gpui-pre $version"
  ensure_rev "$old_rev"
  rev=$(gh api "repos/zed-industries/zed/commits/$short" --jq .sha 2>/dev/null || git -C "$zed" rev-parse "$short")
  ensure_rev "$rev"
  branch="nd/${rev:0:7}"
  if [ -n "$(queue)" ]; then
    cmd_apply
    [ -z "$(git -C "$zed" status --porcelain)" ] || die "$zed has uncommitted changes"
    git -C "$zed" rebase -q --onto "$rev" "$old_rev" "$old_branch" || die "rebase stopped; resolve in $zed, then rerun bump"
    git -C "$zed" branch -m "$old_branch" "$branch"
  fi
  set_conf crate_version "$version"
  set_conf zed_rev "$rev"
  set_conf branch "$branch"
  OLD=$old_version NEW=$version perl -pi -e 's/(package = "gpui-pre(-platform)?", version = ")=\Q$ENV{OLD}\E"/$1=$ENV{NEW}"/' "$workspace"
  NEW=$fast perl -pi -e 's/(package = "gpui-fast(-platform)?", version = ")=[^"]*"/$1=$ENV{NEW}"/' "$workspace"
  [ -z "$(queue)" ] || cmd_export
  cmd_vendor
  say "gpui-pre $old_version (zed@${old_rev:0:7}) -> $version (zed@${rev:0:7}); running the gate"
  cmd_gate
}

cmd_gate() {
  local version rev tmp short
  version=$(get crate_version)
  rev=$(get zed_rev)
  say "1/5 queue applies on zed@${rev:0:7}"
  if [ -n "$(queue)" ]; then
    tmp=$(scratch_fork)
    rm -rf "$tmp"
  fi
  say "2/5 vendored crates and [patch.crates-io] match the queue"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/nd-gpui-vendor.XXXXXX")
  mkdir -p "$tmp/crates/nd-gpui"
  cp "$workspace" "$tmp/Cargo.toml"
  render_vendor "$tmp"
  diff -q "$tmp/Cargo.toml" "$workspace" >/dev/null || die "Cargo.toml's patch block is stale; run vendor"
  diff -r "$tmp/crates/nd-gpui/vendor" "$vendor_dir" >/dev/null 2>&1 ||
    { [ ! -e "$tmp/crates/nd-gpui/vendor" ] && [ ! -e "$vendor_dir" ]; } || die "crates/nd-gpui/vendor is stale; run vendor"
  rm -rf "$tmp"
  say "3/5 pins match gpui-pre $version, the snapshot of zed@${rev:0:7}"
  grep -q "package = \"gpui-pre\", version = \"=$version\"" "$workspace" || die "Cargo.toml does not pin gpui-pre =$version"
  grep -q "package = \"gpui-pre-platform\", version = \"=$version\"" "$workspace" || die "Cargo.toml does not pin gpui-pre-platform =$version"
  if [ "${ND_OFFLINE:-0}" != 1 ]; then
    short=$(cd "$root" && cargo info "gpui-pre@$version" 2>/dev/null | sed -n 's/.*snapshot of zed@\([0-9a-f]*\).*/\1/p')
    [ "${rev:0:${#short}}" = "$short" ] || die "gpui-pre $version snapshots zed@$short, fork.toml says ${rev:0:7}"
  fi
  say "4/5 tiers 1 and 2"
  (cd "$root" && cargo nextest run --profile fast --workspace)
  say "5/5 raw GPUI window builds"
  (cd "$root" && cargo build -q -p nd-gpui --example raw_window --features platform)
  say "gate passed for gpui-pre $version + $(queue | wc -l | tr -d ' ') patch(es)"
}

case "${1:-}" in
  apply | export | vendor | gate) "cmd_$1" ;;
  bump) shift; cmd_bump "$@" ;;
  *) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
