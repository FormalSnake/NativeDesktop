{
  "manifest_version": 3,
  "name": "nd test extension",
  "description": "What 1Password does when it fills a login: a popup asks its service worker, the worker asks a native messaging host, the content script fills the page.",
  "version": "1.0",
  "key": "",
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_title": "nd test" },
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    { "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_start" }
  ],
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"]
}
