From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FormalSnake <kyaniserni@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0100
Subject: [PATCH 6/6] gpui_wgpu: keep the swapchain through an interactive resize

---
diff --git a/crates/gpui_linux/src/linux/wayland/window.rs b/crates/gpui_linux/src/linux/wayland/window.rs
diff --git a/crates/gpui_linux/src/linux/wayland/window.rs b/crates/gpui_linux/src/linux/wayland/window.rs
index ed947e9c..99163c23 100644
--- a/crates/gpui_linux/src/linux/wayland/window.rs
+++ b/crates/gpui_linux/src/linux/wayland/window.rs
@@ -46,6 +46,15 @@ use gpui::{
 };
 use gpui_wgpu::{CompositorGpuHint, WgpuRenderer, WgpuSurfaceConfig, wgpu};
 
+/// Crops the buffer to `source` (buffer pixels from the top left), or shows all of it.
+fn set_viewport_source(viewport: &wp_viewport::WpViewport, source: Option<Size<DevicePixels>>) {
+    match source {
+        Some(size) => viewport.set_source(0.0, 0.0, size.width.0 as f64, size.height.0 as f64),
+        None => viewport.set_source(-1.0, -1.0, -1.0, -1.0),
+    }
+}
+
+
 #[derive(Default)]
 pub(crate) struct Callbacks {
     request_frame: Option<Box<dyn FnMut(RequestFrameOptions)>>,
@@ -141,6 +150,12 @@ pub struct WaylandWindowState {
     /// acked size: acking it right away let the compositor draw the new window geometry around
     /// the old buffer for a frame.
     deferred_configure: Option<(u32, InProgressConfigure)>,
+    /// The compositor's last configure had the `resizing` state: the renderer keeps an oversized
+    /// surface and the viewport crops it, instead of a new swapchain per resize step.
+    live_resize: bool,
+    /// The crop last sent to the viewport, in buffer pixels; `None` while the buffer is the
+    /// window's exact size.
+    viewport_source: Option<Size<DevicePixels>>,
     last_presentation: Option<gpui::PresentationTime>,
     in_progress_window_controls: Option<WindowControls>,
     window_controls: WindowControls,
@@ -558,6 +573,14 @@ pub struct WaylandWindowStatePtr {
 }
 
 impl WaylandWindowState {
+    /// Whether the viewport can crop an oversized buffer: buffer pixels are device pixels only
+    /// with fractional scaling, which leaves the buffer scale at 1.
+    fn can_crop(&self) -> bool {
+        self.viewport.is_some()
+            && self.globals.fractional_scale_manager.is_some()
+            && self.surface.version() >= wl_surface::EVT_PREFERRED_BUFFER_SCALE_SINCE
+    }
+
     pub(crate) fn new(
         handle: AnyWindowHandle,
         surface: wl_surface::WlSurface,
@@ -635,6 +658,8 @@ impl WaylandWindowState {
             in_progress_configure: None,
             resize_throttle: false,
             deferred_configure: None,
+            live_resize: false,
+            viewport_source: None,
             last_presentation: None,
             client,
             appearance,
@@ -1151,9 +1176,19 @@ impl WaylandWindowStatePtr {
                         self.state.borrow_mut().deferred_configure = Some((serial, configure));
                         return;
                     }
+                    self.state.borrow_mut().live_resize = configure.resizing;
                     if let Some(size) = configure.size {
                         self.resize(size);
                     }
+                    if !configure.resizing {
+                        let mut state = self.state.borrow_mut();
+                        if let Some(renderer) = &mut state.renderer
+                            && renderer.surface_size() != renderer.drawable_size()
+                        {
+                            let size = renderer.drawable_size();
+                            renderer.update_drawable_size(size);
+                        }
+                    }
                 }
             }
             let state = self.state.borrow_mut();
@@ -1536,8 +1571,13 @@ impl WaylandWindowStatePtr {
                 state.scale = scale;
             }
             let device_bounds = state.bounds.to_device_pixels(state.scale);
+            let live = state.live_resize && state.can_crop();
             if let Some(renderer) = &mut state.renderer {
-                renderer.update_drawable_size(device_bounds.size);
+                if live {
+                    renderer.update_drawable_size_live(device_bounds.size);
+                } else {
+                    renderer.update_drawable_size(device_bounds.size);
+                }
             }
             (state.bounds.size, state.scale)
         };
@@ -2064,10 +2104,27 @@ impl PlatformWindow for WaylandWindow {
         if let Some(presentation) = &state.globals.presentation {
             presentation.feedback(&state.surface, &state.globals.qh, state.surface.id());
         }
+        let source = (renderer.surface_size() != renderer.drawable_size())
+            .then(|| renderer.drawable_size());
+        let previous_source = state.viewport_source;
+        if source != previous_source
+            && let Some(viewport) = &state.viewport
+        {
+            set_viewport_source(viewport, source);
+            state.viewport_source = source;
+        }
         if renderer.draw(scene) {
             state.presentation = PresentationState::Presented;
             self.0.frame_loop.set(FrameLoop::AwaitingCallback);
         } else {
+            // No buffer went with the crop; restate the one that matches the attached buffer, so a
+            // later commit without a new buffer cannot crop outside it.
+            if state.viewport_source != previous_source
+                && let Some(viewport) = &state.viewport
+            {
+                set_viewport_source(viewport, previous_source);
+                state.viewport_source = previous_source;
+            }
             state.presentation = state.presentation.failed();
             self.0.frame_loop.set(FrameLoop::PresentationFailed);
         }
diff --git a/crates/gpui_wgpu/src/wgpu_renderer.rs b/crates/gpui_wgpu/src/wgpu_renderer.rs
index 088f73be..5c35a135 100644
--- a/crates/gpui_wgpu/src/wgpu_renderer.rs
+++ b/crates/gpui_wgpu/src/wgpu_renderer.rs
@@ -261,9 +261,16 @@ pub struct WgpuRenderer {
     device_errors: Arc<DeviceErrorState>,
     observed_error_generation: u64,
     last_surface_error: Option<String>,
+    /// The size the window shows. The surface can be larger during a live resize, see
+    /// [`WgpuRenderer::update_drawable_size_live`].
+    drawable_size: Size<DevicePixels>,
     needs_redraw: bool,
 }
 
+/// How far a live resize lets the surface outgrow the drawable before it reconfigures, in device
+/// pixels per axis.
+const LIVE_RESIZE_SLACK: u32 = 512;
+
 impl WgpuRenderer {
     fn core(&self) -> Option<&WgpuRendererCore> {
         match &self.state {
@@ -456,6 +463,10 @@ impl WgpuRenderer {
             context: gpu_context,
             compositor_gpu,
             state: RendererState::Ready { surface, core },
+            drawable_size: Size {
+                width: DevicePixels(surface_config.width as i32),
+                height: DevicePixels(surface_config.height as i32),
+            },
             surface_config,
             atlas,
             transparent_alpha_mode,
@@ -989,15 +1000,51 @@ impl WgpuRenderer {
     /// Records the new drawable size and reconfigures the surface when one is present.
     /// The size is kept even without GPU resources so that recovery restores it.
     pub fn update_drawable_size(&mut self, size: Size<DevicePixels>) {
-        let width = size.width.0 as u32;
-        let height = size.height.0 as u32;
-
-        if width == self.surface_config.width && height == self.surface_config.height {
+        self.drawable_size = size;
+        self.configure_surface(size.width.0 as u32, size.height.0 as u32);
+    }
+
+    /// As [`Self::update_drawable_size`], for a size that is about to change again (an
+    /// interactive resize): the surface keeps its size while the drawable fits in it with at most
+    /// [`LIVE_RESIZE_SLACK`] to spare, and otherwise grows with that much headroom. Each surface
+    /// reconfigure idles the device and recreates the swapchain, several milliseconds on a weak
+    /// GPU, so reconfiguring per resize step halves the frame rate there. The frame covers the
+    /// surface's top left `size`; the platform crops the rest with [`Self::surface_size`] and
+    /// [`Self::drawable_size`]. Settle with `update_drawable_size` once the resize ends.
+    pub fn update_drawable_size_live(&mut self, size: Size<DevicePixels>) {
+        self.drawable_size = size;
+        let fits = |drawable: i32, surface: u32| {
+            let drawable = drawable.max(1) as u32;
+            drawable <= surface && surface - drawable <= LIVE_RESIZE_SLACK
+        };
+        if fits(size.width.0, self.surface_config.width) && fits(size.height.0, self.surface_config.height) {
             return;
         }
+        let grow = |drawable: i32| (drawable.max(1) as u32 + LIVE_RESIZE_SLACK / 2).min(self.max_texture_size);
+        self.configure_surface(grow(size.width.0), grow(size.height.0));
+    }
+
+    /// What the window shows: the top left of the surface.
+    pub fn drawable_size(&self) -> Size<DevicePixels> {
+        self.drawable_size
+    }
+
+    /// The swapchain's size, larger than [`Self::drawable_size`] during a live resize.
+    pub fn surface_size(&self) -> Size<DevicePixels> {
+        Size {
+            width: DevicePixels(self.surface_config.width as i32),
+            height: DevicePixels(self.surface_config.height as i32),
+        }
+    }
 
+    fn configure_surface(&mut self, width: u32, height: u32) {
         let clamped_width = width.min(self.max_texture_size);
         let clamped_height = height.min(self.max_texture_size);
+        if clamped_width.max(1) == self.surface_config.width
+            && clamped_height.max(1) == self.surface_config.height
+        {
+            return;
+        }
         if clamped_width != width || clamped_height != height {
             warn!(
                 "Requested surface size ({}, {}) exceeds maximum texture dimension {}. \
