pub mod app;
mod demo;

use nd::prelude::*;

pub fn run() -> nd::Result<()> {
    Application::new(nd::manifest!()).run(|cx| {
        let count = if demo::enabled() { demo::COUNT } else { 0 };
        cx.open_window(WindowOptions::main("main").title("{{title}}"), move |_window, cx| {
            cx.new(|_cx| app::Counter { count })
        })
    })
}
