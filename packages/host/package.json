{
  "name": "@nativedesktop/host",
  "version": "0.3.2",
  "description": "Resolves the prebuilt NativeDesktop host binary for the current platform",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FormalSnake/NativeDesktop.git",
    "directory": "packages/host"
  },
  "homepage": "https://github.com/FormalSnake/NativeDesktop#readme",
  "bugs": "https://github.com/FormalSnake/NativeDesktop/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cef": "./src/cef.ts"
  },
  "optionalDependencies": {
    "@nativedesktop/host-darwin-arm64": "workspace:*",
    "@nativedesktop/host-linux-x64": "workspace:*"
  }
}
