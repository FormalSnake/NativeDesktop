{
  "name": "@nativedesktop/react",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/FormalSnake/NativeDesktop#readme",
  "bugs": "https://github.com/FormalSnake/NativeDesktop/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FormalSnake/NativeDesktop.git",
    "directory": "packages/react"
  },
  "publishConfig": { "access": "public" },
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/packages/react/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/react/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/packages/react/src/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/packages/react/src/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./rpc": {
      "types": "./dist/packages/react/src/generated/rpc.d.ts",
      "default": "./dist/generated/rpc.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun build ./src/index.ts ./src/jsx-runtime.ts ./src/jsx-dev-runtime.ts ./src/generated/rpc.ts --outdir dist --target node --format esm --external react --external react-reconciler --external react-refresh",
    "prepack": "bun run build",
    "prepare": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "dependencies": {
    "react-reconciler": "0.33.0",
    "react-refresh": "0.17.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-reconciler": "0.33.0",
    "@types/react-refresh": "0.14.7",
    "react": "19.2.7",
    "typescript": "7.0.2"
  }
}
