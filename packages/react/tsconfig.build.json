{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "@nativedesktop/react",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun", "react"],
    "noEmit": false,
    "noCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "../..",
    "outDir": "dist"
  },
  "include": ["src/index.ts", "src/jsx-runtime.ts", "src/jsx-dev-runtime.ts"]
}
