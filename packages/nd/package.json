{
  "name": "@nativedesktop/cli",
  "version": "0.3.2",
  "description": "The nd CLI: dev-runs, builds, and packages NativeDesktop apps",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FormalSnake/NativeDesktop.git",
    "directory": "packages/nd"
  },
  "homepage": "https://github.com/FormalSnake/NativeDesktop#readme",
  "bugs": "https://github.com/FormalSnake/NativeDesktop/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "bin": {
