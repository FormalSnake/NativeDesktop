{
  "schemaVersion": 1,
  "style": {
    "keys": {
      "background": { "kind": "color", "css": "background-color" },
      "color":      { "kind": "color", "css": "color" },
      "font": {
        "kind": "object",
        "fields": {
          "fontSize":   { "kind": "int",  "css": "font-size", "unit": "px" },
          "fontWeight": { "kind": "enum", "css": "font-weight", "values": ["normal", "bold"] },
          "fontFamily": { "kind": "string", "css": "font-family" }
        }
      },
      "padding": { "kind": "spacing", "css": "padding", "unit": "px", "target": "css" },
      "margin":  { "kind": "spacing", "target": "widget" },
      "hexpand": { "kind": "bool", "target": "widget" },
      "vexpand": { "kind": "bool", "target": "widget" },
      "halign":  { "kind": "enum", "target": "widget", "values": ["fill", "start", "end", "center"] },
      "valign":  { "kind": "enum", "target": "widget", "values": ["fill", "start", "end", "center"] },
      "border": {
        "kind": "object",
        "fields": {
          "borderWidth":  { "kind": "int",   "css": "border-width",  "unit": "px" },
          "borderColor":  { "kind": "color", "css": "border-color" },
          "borderRadius": { "kind": "int",   "css": "border-radius", "unit": "px" }
        }
      }
    }
  },
  "cssClasses": [
    "suggested-action", "destructive-action", "flat", "raised", "circular", "pill",
    "linked", "toolbar", "spacer",
    "title-1", "title-2", "title-3", "title-4", "heading", "document", "body",
    "caption-heading", "caption", "monospace", "numeric",
    "accent", "success", "warning", "error",
    "boxed-list", "boxed-list-separate", "card", "activatable",
    "navigation-sidebar", "nd-native-sidebar", "selection-mode", "osd",
    "dimmed", "background", "view", "frame", "compact", "menu", "inline",
    "large-title", "property", "round", "opaque", "devel",
    "icon-dropshadow", "lowres-icon"
  ],
  "types": [
    {
      "name": "TableColumn",
      "doc": "Table's per-column shape: stable string id (echoed in sortChanged), header title, optional fixed width in px.",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "title", "type": "string" },
        { "name": "width", "type": "int", "optional": true }
      ]
    },
    {
      "name": "TableRow",
      "doc": "Table's per-row shape: cells are positional, indexed by the columns array order.",
      "fields": [
        { "name": "id", "type": "string", "optional": true },
        { "name": "cells", "type": "string", "list": true }
      ]
    },
    {
      "name": "TreeNode",
      "doc": "TreeView's flat node shape, keyed by id/parentId (root nodes omit parentId). Leaf-row fields (title/badge/iconName) match SourceList's row shape so cell rendering can be shared.",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "parentId", "type": "string", "optional": true },
        { "name": "title", "type": "string" },
        { "name": "badge", "type": "string", "optional": true },
        { "name": "iconName", "type": "string", "optional": true },
        { "name": "hasChildren", "type": "bool" },
        { "name": "expanded", "type": "bool" }
      ]
    },
    {
      "name": "SourceTreeAction",
      "doc": "One trailing row affordance, declared once in the widget's `actions` prop and referenced by nodes via actionIds.",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "iconName", "type": "string" },
        { "name": "label", "type": "string", "optional": true },
        { "name": "tooltip", "type": "string", "optional": true },
        { "name": "destructive", "type": "bool", "optional": true }
      ]
    },
    {
      "name": "SourceTreeNode",
      "doc": "Flat id/parentId sidebar row (root rows omit parentId). `section` marks a non-selectable group header; expansion is app-controlled state, never native state. `iconName` is a freedesktop icon name; `iconData` is raw image bytes as a data URL or bare base64 (what faviconChanged hands you) and WINS over iconName when both are set.",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "parentId", "type": "string", "optional": true },
        { "name": "title", "type": "string" },
        { "name": "caption", "type": "string", "optional": true },
        { "name": "iconName", "type": "string", "optional": true },
        { "name": "iconData", "type": "string", "optional": true },
        { "name": "captionIconName", "type": "string", "optional": true },
        { "name": "badge", "type": "string", "optional": true },
        { "name": "section", "type": "bool", "optional": true },
        { "name": "hasChildren", "type": "bool", "optional": true },
        { "name": "expanded", "type": "bool", "optional": true },
        { "name": "selectable", "type": "bool", "optional": true },
        { "name": "actionIds", "type": "string", "list": true, "optional": true },
        { "name": "testID", "type": "string", "optional": true }
      ]
    },
    {
      "name": "CommandPaletteItem",
      "doc": "CommandPalette result row: stable string id (echoed in onActivate), title, optional subtitle + leading icon. The app supplies rows already filtered and ordered; the widget renders them in order and never filters or reorders.",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "title", "type": "string" },
        { "name": "subtitle", "type": "string", "optional": true },
        { "name": "iconName", "type": "string", "optional": true }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Window",
      "intrinsic": "window",
      "container": { "childModel": "single" },
      "props": [
        { "name": "title", "type": "string", "appliesTo": "createAndUpdate" },
        { "name": "defaultWidth", "type": "int", "default": 480, "appliesTo": "create" },
        { "name": "defaultHeight", "type": "int", "default": 320, "appliesTo": "create" },
        { "name": "tabGroup", "type": "string", "appliesTo": "create" },
        { "name": "toolbarStyle", "type": "enum", "values": ["unified", "unifiedCompact", "expanded", "preference"], "default": "unified", "appliesTo": "create" },
        { "name": "frameAutosaveName", "type": "string", "appliesTo": "create" },
        { "name": "density", "type": "enum", "values": ["standard", "compact"], "default": "standard", "appliesTo": "create" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [
        { "name": "alertResult", "ndpName": "onAlertResult", "payload": "data" },
        { "name": "openFileResult", "ndpName": "onOpenFileResult", "payload": "data" },
        { "name": "saveFileResult", "ndpName": "onSaveFileResult", "payload": "data" },
        { "name": "newTabRequested", "ndpName": "onNewTabRequested", "payload": "data" },
        { "name": "closed", "ndpName": "onClosed", "payload": "data" },
        { "name": "focused", "ndpName": "onFocused", "payload": "checked" },
        { "name": "sizeChanged", "ndpName": "onSizeChanged", "payload": "data" }
      ],
      "commands": ["showAlert", "openFile", "saveFile", "showAbout", "showTabOverview", "present"],
      "automation": { "role": "window", "textFrom": "title" }
    },
    {
      "name": "Box",
      "intrinsic": "box",
      "container": { "childModel": "multi" },
      "props": [
        { "name": "orientation", "type": "enum", "values": ["vertical", "horizontal"], "default": "vertical", "appliesTo": "create" },
        { "name": "spacing", "type": "int", "default": -1, "appliesTo": "createAndUpdate" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [
        { "name": "hoverChanged", "ndpName": "onHoverChanged", "payload": "checked" }
      ],
      "automation": { "role": "group", "textFrom": null }
    },
    {
      "name": "Label",
      "intrinsic": "label",
      "container": null,
      "props": [
        { "name": "text", "type": "string", "default": "", "appliesTo": "create" },
        { "name": "ellipsize", "type": "bool", "default": false, "appliesTo": "create" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [],
      "automation": { "role": "label", "textFrom": "text" }
    },
    {
      "name": "Button",
      "commands": ["focus"],
      "intrinsic": "button",
      "container": null,
      "props": [
        { "name": "label", "type": "string", "default": "", "appliesTo": "createAndUpdate" },
        { "name": "testID", "type": "string", "appliesTo": "meta" },
        { "name": "iconName", "type": "string", "appliesTo": "create" },
        { "name": "iconData", "type": "string", "appliesTo": "createAndUpdate" },
        { "name": "labelAlign", "type": "enum", "values": ["start", "center", "end"], "default": "center", "appliesTo": "create" },
        { "name": "ellipsize", "type": "bool", "default": false, "appliesTo": "create" },
        { "name": "tooltip", "type": "string", "appliesTo": "createAndUpdate" },
        { "name": "prominent", "type": "bool", "default": false, "appliesTo": "createAndUpdate" },
        { "name": "badge", "type": "string", "appliesTo": "createAndUpdate" },
        { "name": "size", "type": "enum", "values": ["small", "regular", "large"], "default": "regular", "appliesTo": "createAndUpdate" }
      ],
      "events": [
        { "name": "clicked", "ndpName": "onClick" },
        { "name": "hoverChanged", "ndpName": "onHoverChanged", "payload": "checked" }
      ],
      "automation": { "role": "button", "textFrom": "label" }
    },
    {
      "name": "TextInput",
      "commands": ["focus"],
      "intrinsic": "textinput",
      "container": null,
      "props": [
        { "name": "text", "type": "string", "default": "", "appliesTo": "createAndUpdate" },
        { "name": "placeholder", "type": "string", "appliesTo": "createAndUpdate" },
        { "name": "editable", "type": "bool", "default": true, "appliesTo": "createAndUpdate" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [
        { "name": "changed", "ndpName": "onChanged", "payload": "text" },
        { "name": "activate", "ndpName": "onActivate", "payload": "text" }
      ],
      "automation": { "role": "textbox", "textFrom": "text" }
    },
    {
      "name": "TextArea",
      "commands": ["focus"],
      "intrinsic": "textarea",
      "container": null,
      "props": [
        { "name": "text", "type": "string", "default": "", "appliesTo": "createAndUpdate" },
        { "name": "minContentHeight", "type": "int", "default": 120, "appliesTo": "create" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [
        { "name": "changed", "ndpName": "onChanged", "payload": "text" }
      ],
      "automation": { "role": "textbox", "textFrom": "text" }
    },
    {
      "name": "Checkbox",
      "intrinsic": "checkbox",
      "container": null,
      "props": [
        { "name": "checked", "type": "bool", "default": false, "appliesTo": "createAndUpdate" },
        { "name": "label", "type": "string", "default": "", "appliesTo": "createAndUpdate" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [
        { "name": "toggled", "ndpName": "onToggled", "payload": "checked" }
      ],
      "automation": { "role": "checkbox", "textFrom": "label" }
    },
    {
      "name": "Radio",
      "intrinsic": "radio",
      "container": null,
      "props": [
        { "name": "group", "type": "string", "required": true, "appliesTo": "create" },
        { "name": "checked", "type": "bool", "default": false, "appliesTo": "createAndUpdate" },
        { "name": "label", "type": "string", "default": "", "appliesTo": "createAndUpdate" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [
        { "name": "toggled", "ndpName": "onToggled", "payload": "checked" }
      ],
      "automation": { "role": "radio", "textFrom": "label" }
    },
    {
      "name": "Select",
      "intrinsic": "select",
      "container": null,
      "props": [
        { "name": "options", "type": "stringList", "appliesTo": "create" },
        { "name": "selectedIndex", "type": "int", "default": 0, "appliesTo": "createAndUpdate" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [
        { "name": "selectionChanged", "ndpName": "onSelectionChanged", "payload": "index" }
      ],
      "automation": { "role": "combobox", "textFrom": null }
    },
    {
      "name": "Slider",
      "intrinsic": "slider",
      "container": null,
      "props": [
        { "name": "min", "type": "float", "default": 0, "appliesTo": "create" },
        { "name": "max", "type": "float", "default": 100, "appliesTo": "create" },
        { "name": "step", "type": "float", "default": 1, "appliesTo": "create" },
        { "name": "value", "type": "float", "default": 0, "appliesTo": "createAndUpdate" },
        { "name": "orientation", "type": "enum", "values": ["horizontal", "vertical"], "default": "horizontal", "appliesTo": "create" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [
        { "name": "valueChanged", "ndpName": "onValueChanged", "payload": "value" }
      ],
      "automation": { "role": "slider", "textFrom": null }
    },
    {
      "name": "ProgressBar",
      "intrinsic": "progressbar",
      "container": null,
      "props": [
        { "name": "fraction", "type": "float", "default": 0, "appliesTo": "createAndUpdate" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [],
      "automation": { "role": "progressbar", "textFrom": null }
    },
    {
      "name": "Image",
      "intrinsic": "image",
      "container": null,
      "props": [
        { "name": "path", "type": "string", "appliesTo": "createAndUpdate" },
        { "name": "iconName", "type": "string", "appliesTo": "createAndUpdate" },
        { "name": "pixelSize", "type": "int", "default": 0, "appliesTo": "createAndUpdate" },
        { "name": "symbolScale", "type": "enum", "values": ["small", "medium", "large"], "default": "medium", "appliesTo": "create" },
        { "name": "symbolWeight", "type": "enum", "values": ["regular", "medium", "semibold", "bold"], "default": "regular", "appliesTo": "create" },
        { "name": "symbolRenderingMode", "type": "enum", "values": ["monochrome", "hierarchical", "multicolor"], "default": "monochrome", "appliesTo": "create" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [],
      "automation": { "role": "image", "textFrom": null }
    },
    {
      "name": "ScrollView",
      "intrinsic": "scrollview",
      "container": { "childModel": "single" },
      "props": [
        { "name": "minContentHeight", "type": "int", "default": 0, "appliesTo": "create" },
        { "name": "hscroll", "type": "enum", "values": ["auto", "never"], "default": "auto", "appliesTo": "create" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [],
      "automation": { "role": "scrollarea", "textFrom": null }
    },
    {
      "name": "Separator",
      "intrinsic": "separator",
      "container": null,
      "props": [
        { "name": "orientation", "type": "enum", "values": ["horizontal", "vertical"], "default": "horizontal", "appliesTo": "create" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [],
      "automation": { "role": "separator", "textFrom": null }
    },
    {
      "name": "Spinner",
      "intrinsic": "spinner",
      "container": null,
      "props": [
        { "name": "spinning", "type": "bool", "default": true, "appliesTo": "createAndUpdate" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [],
      "automation": { "role": "spinner", "textFrom": null }
    },
    {
      "name": "TabView",
      "intrinsic": "tabview",
      "container": {
        "childModel": "multi",
        "attachedProps": [
          { "name": "tabLabel", "type": "string", "default": "" },
          { "name": "tabIcon", "type": "string", "default": "" }
        ]
      },
      "props": [
        { "name": "selectedIndex", "type": "int", "default": 0, "appliesTo": "createAndUpdate" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [],
      "automation": { "role": "tablist", "textFrom": null }
    },
    {
      "name": "Grid",
      "intrinsic": "grid",
      "container": {
        "childModel": "multi",
        "attachedProps": [
          { "name": "gridRow", "type": "int", "default": 0 },
          { "name": "gridColumn", "type": "int", "default": 0 },
          { "name": "gridRowSpan", "type": "int", "default": 1 },
          { "name": "gridColumnSpan", "type": "int", "default": 1 }
        ]
      },
      "props": [
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [],
      "automation": { "role": "grid", "textFrom": null }
    },
    {
      "name": "ListView",
      "intrinsic": "listview",
      "container": null,
      "props": [
        { "name": "items", "type": "stringList", "appliesTo": "createAndUpdate" },
        { "name": "selectedIndex", "type": "int", "default": -1, "appliesTo": "createAndUpdate" },
        { "name": "emptyIconName", "type": "string", "appliesTo": "createAndUpdate" },
        { "name": "emptyTitle", "type": "string", "appliesTo": "createAndUpdate" },
        { "name": "emptyDescription", "type": "string", "appliesTo": "createAndUpdate" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [
        { "name": "rowActivated", "ndpName": "onRowActivated", "payload": "index" }
      ],
      "automation": { "role": "list", "textFrom": null }
    },
    {
      "name": "WebView",
      "intrinsic": "webview",
      "container": null,
      "props": [
        { "name": "url", "type": "string", "default": "", "appliesTo": "createAndUpdate" },
        { "name": "profile", "type": "string", "default": "", "appliesTo": "create" },
        { "name": "suppressContextMenu", "type": "bool", "default": false, "appliesTo": "create" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [
        { "name": "navigate", "ndpName": "onNavigate", "payload": "text" },
        { "name": "titleChanged", "ndpName": "onTitleChanged", "payload": "text" },
        { "name": "loadingChanged", "ndpName": "onLoadingChanged", "payload": "checked" },
        { "name": "backAvailable", "ndpName": "onBackAvailable", "payload": "checked" },
        { "name": "forwardAvailable", "ndpName": "onForwardAvailable", "payload": "checked" },
        { "name": "loadProgress", "ndpName": "onLoadProgress", "payload": "value" },
        { "name": "loadFailed", "ndpName": "onLoadFailed", "payload": "data" },
        { "name": "newWindow", "ndpName": "onNewWindow", "payload": "text" },
        { "name": "downloadRequested", "ndpName": "onDownloadRequested", "payload": "data" },
        { "name": "javaScriptResult", "ndpName": "onJavaScriptResult", "payload": "data" },
        { "name": "scriptMessage", "ndpName": "onScriptMessage", "payload": "data" },
        { "name": "schemeRequest", "ndpName": "onSchemeRequest", "payload": "data" },
        { "name": "cookiesResult", "ndpName": "onCookiesResult", "payload": "data" },
        { "name": "cookiesChanged", "ndpName": "onCookiesChanged", "payload": "data" },
        { "name": "faviconChanged", "ndpName": "onFaviconChanged", "payload": "data" },
        { "name": "findResult", "ndpName": "onFindResult", "payload": "data" },
        { "name": "securityChanged", "ndpName": "onSecurityChanged", "payload": "data" },
        { "name": "linkHover", "ndpName": "onLinkHover", "payload": "text" },
        { "name": "contextMenu", "ndpName": "onContextMenu", "payload": "data" },
        { "name": "sessionSaved", "ndpName": "onSessionSaved", "payload": "data" },
        { "name": "audioStateChanged", "ndpName": "onAudioStateChanged", "payload": "data" }
      ],
      "commands": [
        "goBack", "goForward", "reload", "stop", "executeJavaScript", "setZoom", "setUserAgent", "openDevTools",
        "addUserScript", "removeUserScript", "clearUserScripts",
        "registerScriptMessage", "unregisterScriptMessage",
        "respondScheme",
        "getCookies", "setCookie", "deleteCookie",
        "findStart", "findNext", "findPrevious", "findStop",
        "saveSession", "restoreSession", "setMuted",
        "focus"
      ],
      "automation": { "role": "webview", "textFrom": null }
    },
    {
      "name": "NativeView",
      "intrinsic": "nativeview",
      "container": null,
      "props": [
        { "name": "viewKind", "type": "string", "appliesTo": "create" },
        { "name": "props", "type": "string", "default": "{}", "appliesTo": "createAndUpdate" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [
        { "name": "nativeEvent", "ndpName": "onNativeEvent", "payload": "data" }
      ],
      "commands": [],
      "automation": { "role": "custom", "textFrom": null }
    },
    {
      "name": "SplitView",
      "intrinsic": "splitview",
      "container": {
        "childModel": "multi",
        "attachedProps": [
          { "name": "slot", "type": "enum", "values": ["sidebar", "content", "list", "inspector"], "default": "content" }
        ]
      },
      "props": [
        { "name": "sidebarWidth", "type": "float", "default": 0.0, "appliesTo": "create" },
        { "name": "collapsed", "type": "bool", "default": false, "appliesTo": "createAndUpdate" },
        { "name": "listWidth", "type": "float", "default": 0.0, "appliesTo": "create" },
        { "name": "breakpoint", "type": "int", "default": 0, "appliesTo": "create" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [],
      "automation": { "role": "group", "textFrom": null }
    },
    {
      "name": "HeaderBar",
      "intrinsic": "headerbar",
      "container": {
        "childModel": "multi",
        "attachedProps": [
          { "name": "slot", "type": "enum", "values": ["start", "end"], "default": "start" }
        ]
      },
      "props": [
        { "name": "title", "type": "string", "default": "", "appliesTo": "createAndUpdate" },
        { "name": "subtitle", "type": "string", "appliesTo": "createAndUpdate" },
        { "name": "showTitleButtons", "type": "bool", "default": true, "appliesTo": "create" },
        { "name": "canGoBack", "type": "bool", "default": false, "appliesTo": "createAndUpdate" },
        { "name": "canGoForward", "type": "bool", "default": false, "appliesTo": "createAndUpdate" },
        { "name": "testID", "type": "string", "appliesTo": "meta" }
      ],
      "events": [
        { "name": "back", "ndpName": "onBack" },
        { "name": "forward", "ndpName": "onForward" }
      ],
      "automation": { "role": "toolbar", "textFrom": "title" }
    },
    {
      "name": "ToolbarView",
      "intrinsic": "toolbarview",
      "container": {
