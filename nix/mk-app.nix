# `nativedesktop.lib.mkApp`: the flake outputs of one nativedesktop app.
#
#   outputs = { nativedesktop, nixpkgs, ... }:
#     nativedesktop.lib.mkApp {
#       inherit nixpkgs;
#       src = ./.;
#       pname = "notes";
#     };
#
# Returns `packages`, `devShells`, `checks` and `homeModules`. `packages.default` and the crane
# checks (clippy, nextest, fmt) exist on Linux; macOS apps are packaged by `nd package mac`, which
# needs Xcode and cannot run in the Nix sandbox. The home-manager module and its evaluation check
# exist everywhere.
#
# An app whose `nd` dependency has the `webview` feature carries Chromium (nd-cef) on Linux: the
# build gets the CEF distribution from the store (`nix/cef.nix`) instead of downloading it, and
# the package keeps `libcef.so` and its resources beside the real executable in
# `libexec/<pname>`, where the executable's `$ORIGIN` run path finds them.
{
  crane,
  mkDevShell,
  runtimeLibs,
  cefLibs,
}:
{
  nixpkgs,
  src,
  pname,
  systems ? [
    "aarch64-darwin"
    "x86_64-linux"
    "aarch64-linux"
  ],
  # Typed options generated by nd-hm-gen from the settings schema.
  settingsOptions ? src + "/nix/settings-options.nix",
  # Extra files the build needs next to the Rust sources (assets, nativedesktop.toml).
  extraFileset ? (_: [ ]),
  nativeBuildInputs ? (_: [ ]),
  buildInputs ? (_: [ ]),
  # Settings the module check must render, and the lines it must contain.
  moduleCheck ? null,
  # Whether the app shows web views, so its Linux package carries Chromium. Read from the `nd`
  # dependency's features in the app's Cargo.toml.
  webview ? builtins.elem "webview" (
    ((builtins.fromTOML (builtins.readFile (src + "/Cargo.toml"))).dependencies.nd or { }).features or [ ]
  ),
}:
let
  lib = nixpkgs.lib;
  forAll = f: lib.genAttrs systems (system: f nixpkgs.legacyPackages.${system});
  buildable = pkgs: pkgs.stdenv.hostPlatform.isLinux;

  perSystem = forAll (
    pkgs:
    let
      craneLib = crane.mkLib pkgs;
      fileset = lib.fileset.unions (
        [
          (craneLib.fileset.commonCargoSources src)
          (src + "/nativedesktop.toml")
        ]
        ++ extraFileset pkgs
      );
      cleanSrc = lib.fileset.toSource {
        root = src;
        inherit fileset;
      };
      cef = import ./cef.nix { inherit pkgs; };
      web = webview && pkgs.stdenv.hostPlatform.isLinux;
      common = {
        inherit pname;
        src = cleanSrc;
        strictDeps = true;
        nativeBuildInputs =
          [
            pkgs.pkg-config
            pkgs.makeWrapper
          ]
          ++ lib.optionals web [
            pkgs.cmake
            pkgs.ninja
          ]
          ++ nativeBuildInputs pkgs;
        buildInputs = runtimeLibs pkgs ++ lib.optionals web (cefLibs pkgs) ++ buildInputs pkgs;
      }
      // lib.optionalAttrs web {
        CEF_PATH = cef;
      };
      cargoArtifacts = craneLib.buildDepsOnly common;
      args = common // {
        inherit cargoArtifacts;
      };
      package = craneLib.buildPackage (
        args
        // {
          doCheck = false;
          meta.mainProgram = pname;
          # GPUI loads these with dlopen; the binary does not link them. Chromium's runtime is
          # copied rather than linked: nd-cef finds its resources beside the libcef.so it loaded.
          postInstall =
            lib.optionalString web ''
              mkdir -p $out/libexec/${pname}
              mv $out/bin/${pname} $out/libexec/${pname}/
              cp -rL ${cef}/. $out/libexec/${pname}/
              rm -rf $out/libexec/${pname}/{include,libcef_dll,cmake,CMakeLists.txt,archive.json}
              makeWrapper $out/libexec/${pname}/${pname} $out/bin/${pname} \
                --prefix LD_LIBRARY_PATH : ${lib.makeLibraryPath (runtimeLibs pkgs)}
            ''
            + lib.optionalString (!web) ''
              wrapProgram $out/bin/${pname} --prefix LD_LIBRARY_PATH : ${lib.makeLibraryPath (runtimeLibs pkgs)}
            '';
        }
      );
    in
    {
      inherit package;
      checks = {
        "${pname}-clippy" = craneLib.cargoClippy (args // { cargoClippyExtraArgs = "--all-targets -- --deny warnings"; });
        "${pname}-nextest" = craneLib.cargoNextest (args // { cargoNextestExtraArgs = "--profile fast"; });
        "${pname}-fmt" = craneLib.cargoFmt { inherit pname; src = cleanSrc; };
      };
      devShell = mkDevShell pkgs;
    }
  );

  homeModule = import ./hm-module.nix {
    inherit pname;
    settingsOptions = import settingsOptions;
    defaultPackage =
      system:
      if builtins.elem system systems && buildable nixpkgs.legacyPackages.${system} then
        perSystem.${system}.package
      else
        throw "${pname}: no Nix package for ${system}, set programs.${pname}.package";
  };

  hmEvalCheck = import ./hm-eval-check.nix { inherit lib; };
in
{
  packages = lib.mapAttrs (_: s: { default = s.package; }) (
    lib.filterAttrs (system: _: buildable nixpkgs.legacyPackages.${system}) perSystem
  );
  devShells = lib.mapAttrs (_: s: { default = s.devShell; }) perSystem;
  checks = forAll (
    pkgs:
    (lib.optionalAttrs (buildable pkgs) perSystem.${pkgs.stdenv.hostPlatform.system}.checks)
    // lib.optionalAttrs (moduleCheck != null) {
      "${pname}-hm-module-eval" = hmEvalCheck (moduleCheck // { inherit pkgs pname homeModule; });
    }
  );
  homeModules.default = homeModule;
}
