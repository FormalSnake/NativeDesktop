# The home-manager module every nativedesktop app shares. `mkApp` instantiates it per app:
#
#   pname            the app and its option name, `programs.<pname>`
#   settingsOptions  `{ lib, tomlType }: { <typed options> }`, generated by nd-hm-gen
#                    from the app's settings schema (nix/settings-options.nix)
#   defaultPackage   `system: package`, the default for `package`
#
# Typed options are `nullOr` with a null default and are dropped before `config.toml` is
# rendered, so a file only carries what the user set. The app layers the defaults underneath and
# marks exactly those keys "Managed by Nix".
{
  pname,
  settingsOptions,
  defaultPackage,
}:
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.programs.${pname};
  toml = pkgs.formats.toml { };
  json = pkgs.formats.json { };
  isDarwin = pkgs.stdenv.hostPlatform.isDarwin;

  prune =
    v:
    if builtins.isAttrs v then
      lib.filterAttrs (_: x: x != null && x != { }) (lib.mapAttrs (_: prune) v)
    else if builtins.isList v then
      map prune v
    else
      v;
  settings = prune cfg.settings;

  # macOS apps read ~/Library/Application Support/<pname>, everything else $XDG_CONFIG_HOME/<pname>.
  # Both branches are mkIf rather than an `if`: under useGlobalPkgs `pkgs` comes from config, so a
  # module whose attribute names depend on `pkgs` recurses forever.
  configFile = name: source: {
    home.file."Library/Application Support/${pname}/${name}" = lib.mkIf isDarwin { inherit source; };
    xdg.configFile."${pname}/${name}" = lib.mkIf (!isDarwin) { inherit source; };
  };
in
{
  options.programs.${pname} = {
    enable = lib.mkEnableOption pname;

    package = lib.mkOption {
      type = lib.types.package;
      default = defaultPackage pkgs.stdenv.hostPlatform.system;
      defaultText = lib.literalExpression "<flake>.packages.\${system}.default";
      description = "The ${pname} package to install.";
    };

    autostart = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Start ${pname} with the graphical session (systemd user service, launchd agent on macOS).";
    };

    environmentFile = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "/run/secrets/${pname}.env";
      description = ''
        File of `KEY=value` lines passed to the autostart service, for secrets that must stay
        out of the Nix store. Not supported by the macOS launchd agent.
      '';
    };

    settings = lib.mkOption {
      type = lib.types.submodule {
        options =
          {
            # Replaced by the typed `plugins` option when the app registers plugins.
            plugins = lib.mkOption {
              type = lib.types.attrsOf toml.type;
              default = { };
              description = "Plugin sections, written as `[plugins.<name>]`. Each plugin checks its own keys.";
            };
          }
          // settingsOptions {
            inherit lib;
            tomlType = toml.type;
          };
      };
      default = { };
      description = ''
        Written to `config.toml`. Keys set here are read-only in the app's settings window, which
        shows the option path and a "Copy as Nix" action. A key left unset keeps the app's default
        and stays editable.
      '';
    };

    theme = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = { };
      example = {
        accent = "#6099c0";
      };
      description = ''
        Palette tokens written to `theme.json`. Leave empty to let another tool (matugen, for
        one) own the file.
      '';
    };
  };

  config = lib.mkIf cfg.enable (
    lib.mkMerge [
      { home.packages = [ cfg.package ]; }

      (lib.mkIf (settings != { }) (configFile "config.toml" (toml.generate "${pname}-config.toml" settings)))

      (lib.mkIf (cfg.theme != { }) (configFile "theme.json" (json.generate "${pname}-theme.json" cfg.theme)))

      (lib.mkIf (cfg.autostart && !isDarwin) {
        systemd.user.services.${pname} = {
          Unit = {
            Description = pname;
            PartOf = [ "graphical-session.target" ];
            After = [ "graphical-session.target" ];
          };
          Service = {
            ExecStart = lib.getExe cfg.package;
            Restart = "on-failure";
          } // lib.optionalAttrs (cfg.environmentFile != null) { EnvironmentFile = cfg.environmentFile; };
          Install.WantedBy = [ "graphical-session.target" ];
        };
      })

      (lib.mkIf (cfg.autostart && isDarwin) {
        launchd.agents.${pname} = {
          enable = true;
          config = {
            ProgramArguments = [ (lib.getExe cfg.package) ];
            RunAtLoad = true;
            KeepAlive = {
              SuccessfulExit = false;
            };
          };
        };
      })

      {
        assertions = [
          {
            assertion = !(isDarwin && cfg.autostart && cfg.environmentFile != null);
            message = "programs.${pname}.environmentFile is not supported by the macOS launchd agent.";
          }
        ];
      }
    ]
  );
}
